{
  "name": "laoyu-desk-tv",
  "version": "0.3.6",
  "description": "Laoyu Desk TV · 捞鱼桌脚看电视，桌面小窗视频播放器",
  "main": "src/main/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win nsis zip --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never && node scripts/mac-update-zips.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "com.laoyu.paidtowatch",
    "productName": "捞鱼桌脚看电视",
    "files": [
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "README.md",
      "src/**/*",
      "assets/**/*",
      "scripts/ui-smoke.js",
      "tests/fixtures/silent.webm"
    ],
    "artifactName": "laoyu-desk-tv-${version}-${os}-${arch}.${ext}",
    "icon": "assets/icon.png",
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "include": "scripts/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "uninstallDisplayName": "捞鱼桌脚看电视"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "publish": {
      "provider": "github",
      "owner": "lyzbcy",
      "repo": "laoyu-desk-tv"
    }
  },
  "author": "捞鱼工作室",
  "dependencies": {
    "koffi": "3.1.0"
  }
}
